{"model":"qwen2.5-coder:14b","created_at":"2026-05-03T02:59:38.168005Z","response":"```bash\n#!/usr/bin/env bash\n# harden/harden-ssh.sh -- Harden /etc/ssh/sshd_config on Ubuntu 24.04\n# Idempotent: only writes managed file when content differs.\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" \u0026\u0026 pwd)\"\n# shellcheck source=../install/lib/common.sh\nsource \"${SCRIPT_DIR}/../install/lib/common.sh\"\n\nTARGET_FILE=\"/etc/ssh/sshd_config.d/52-litesoup-harden.conf\"\nCONFIG_CONTENT=\"PermitRootLogin no\\nPasswordAuthentication no\\nMaxAuthTries 3\\nClientAliveInterval 300\\nClientAliveCountMax 2\\nX11Forwarding no\\nAllowAgentForwarding no\\nPermitEmptyPasswords no\"\n\nusage() {\n    cat \u003c\u003c'EOF'\nlitesoup harden-ssh — Harden SSH configuration on Ubuntu 24.04\nUsage: sudo bash harden-ssh.sh [--dry-run] [--help]\nEOF\n}\n\nwrite_if_changed() {\n    local path=\"$1\" content=\"$2\"\n    if [ -f \"${path}\" ] \u0026\u0026 printf '%s' \"${content}\" | cmp -s - \"${path}\"; then\n        log_info \"${path} already up to date\"\n        return 0\n    fi\n    local tmp; tmp=$(mktemp)\n    printf '%s' \"${content}\" \u003e \"${tmp}\"\n    install -m 0644 -o root -g root \"${tmp}\" \"${path}\"\n    rm -f \"${tmp}\"\n    log_info \"wrote ${path}\"\n    CHANGED=1\n}\n\nmain() {\n    for arg in \"$@\"; do\n        case \"${arg}\" in\n            --dry-run) DRY_RUN=1 ;;\n            --help|-h) usage; exit 0 ;;\n            *) log_error \"unknown argument: ${arg}\"; usage; exit 64 ;;\n        esac\n    done\n    export DRY_RUN\n    require_root\n\n    # Validate the new config before applying\n    if ! sshd -t -f /etc/ssh/sshd_config; then\n        log_error \"Invalid SSH configuration. Aborting without changes.\"\n        exit 1\n    fi\n\n    # Write the managed override file if content differs\n    write_if_changed \"${TARGET_FILE}\" \"${CONFIG_CONTENT}\"\n\n    # Reload ssh service if config changed\n    if [ -n \"${CHANGED}\" ]; then\n        run_or_dryrun systemctl reload ssh\n    fi\n\n    # Print final state\n    grep -E '^(PermitRootLogin|PasswordAuthentication|MaxAuthTries)' /etc/ssh/sshd_config.d/*.conf 2\u003e/dev/null\n}\n\nmain \"$@\"\n```","done":true,"done_reason":"stop","context":[151644,8948,198,2610,525,1207,16948,11,3465,553,54364,14817,13,1446,525,264,10950,17847,13,151645,198,151644,872,198,2610,525,4378,264,27023,5316,13,45477,37439,4769,26687,3168,53679,35768,1959,902,50494,69155,11,902,89454,11,902,30610,13,5145,697,2033,448,671,87980,7063,8749,14358,27023,323,835,448,279,1537,1555,315,279,5316,382,45583,26773,320,2870,419,686,387,6781,1648,608,7137,14109,6161,48789,14,29958,13328,3611,13346,7530,8341,7530,8341,12,25537,2395,271,787,2045,3418,6784,42386,320,80116,1959,2432,1493,6896,7731,16,13,2932,27174,25,671,87980,7063,8749,14358,27023,198,17,13,6909,25,220,17,8447,3980,2504,22692,7428,11,1221,264,10431,368,729,448,264,1565,4616,1115,23483,2503,29457,63,24567,2504,14838,8042,198,18,13,4636,4247,25,53679,8291,15785,4385,41553,14434,10857,87663,25430,58,15,13989,899,1,1009,32706,8,1221,1565,2427,10857,24787,8291,4472,1244,12248,8194,11356,2395,39917,320,574,6696,1565,746,481,36,20128,78,13647,18403,7808,1487,3109,19413,55045,19413,4096,11,1598,8734,814,884,6108,11,1373,12993,11,10165,22862,340,19,13,5443,1598,8734,814,884,6108,369,894,1584,48861,1179,320,12248,481,76,11,23164,11,89421,11,29230,67,18646,340,20,13,9186,1177,53210,22973,5181,320,4917,323,12794,422,11242,24068,28,16,340,21,13,9186,1177,8653,5181,320,44620,10431,26,4869,220,15,340,22,13,1373,12993,1573,1584,4344,198,23,13,5223,3262,63532,25,1172,3270,279,8975,2193,1034,421,2213,43542,504,1482,320,7293,5383,25,3270,311,23789,3888,11,26089,481,82,448,2169,11,4582,421,1745,11,18998,4174,340,24,13,12528,2028,1969,1494,448,93797,87,481,68,7531,16,15,24,16,19324,95875,62947,320,7201,518,419,5383,369,279,1034,594,8084,6083,7731,220,54275,46216,198,220,671,87980,7063,8749,14358,27023,198,220,671,2588,268,7530,8341,30550,2395,1177,825,8