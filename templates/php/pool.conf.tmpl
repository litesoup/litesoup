; Generated by litesoup ensure_php_pool_for_user — do not edit by hand.
; Pool: __POOL_NAME__ (user __USER__, php __PHP_VERSION__)
; Tier directives below (pm + sizing) are rendered from
; php_pool_tier_block <tier> in install/lib/php.sh. Tier defaults to "small"
; for v0.3 back-compat. Re-run ensure_php_pool_for_user with a different tier
; to retune.
[__POOL_NAME__]
user = __USER__
group = __USER__
listen = __SOCKET__
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

__TIER_BLOCK__

; open_basedir confines this user's PHP processes to their own webapps tree.
php_admin_value[open_basedir] = /home/__USER__/webapps/:/home/__USER__/.php_tmp/:/home/__USER__/.php_sessions/
php_admin_value[upload_tmp_dir] = /home/__USER__/.php_tmp
php_admin_value[session.save_path] = /home/__USER__/.php_sessions
php_admin_value[error_log] = /home/__USER__/.logs/php__PHP_VERSION__-fpm.error.log
php_admin_flag[log_errors] = on

; Hardening — disable dangerous functions WordPress core does not need.
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec,proc_get_status
php_admin_flag[expose_php] = off
php_admin_flag[allow_url_fopen] = off
php_admin_flag[allow_url_include] = off

php_value[memory_limit] = 256M
php_value[max_execution_time] = 60
php_value[upload_max_filesize] = 64M
php_value[post_max_size] = 64M
