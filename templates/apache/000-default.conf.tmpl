# 000-default.conf — litesoup catch-all vhost.
# Serves 404 for any request that doesn't match a named site (IP access,
# unknown domains), preventing fallback to the alphabetically first site.
# Installed by install-stack.sh stage 17.

<VirtualHost _default_:80>
    DocumentRoot /var/www/html
    <Directory /var/www/html>
        Require all denied
    </Directory>
    Redirect 404 /
</VirtualHost>

<VirtualHost _default_:443>
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/ssl-cert-snakeoil.pem
    SSLCertificateKeyFile /etc/ssl/private/ssl-cert-snakeoil.key
    DocumentRoot /var/www/html
    <Directory /var/www/html>
        Require all denied
    </Directory>
    Redirect 404 /
</VirtualHost>
