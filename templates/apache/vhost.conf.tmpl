# Generated by litesoup site-create.sh — do not edit by hand.
# When TLS is active for this site, __HTTP_REDIRECT__ contains the rewrite
# rules (with an exception for /.well-known/acme-challenge/ so LE renewal
# keeps working) and __HTTPS_BLOCK__ contains the full <VirtualHost *:443>.
# When TLS is none (HTTP-only site), both placeholders are empty strings and
# only the HTTP server below serves the site.

<VirtualHost *:80>
    ServerName __DOMAIN__
    DocumentRoot __DOCROOT__

    # Always allow LE HTTP-01 challenge under .well-known/acme-challenge,
    # even when the rest of the site redirects to HTTPS.
    Alias /.well-known/acme-challenge/ __DOCROOT__/.well-known/acme-challenge/
    <Directory "__DOCROOT__/.well-known/acme-challenge/">
        Options None
        AllowOverride None
        Require all granted
    </Directory>

__HTTP_REDIRECT__

    <Directory __DOCROOT__>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch \.php$>
        SetHandler "proxy:unix:__FPM_SOCKET__|fcgi://localhost"
    </FilesMatch>

    ErrorLog  ${APACHE_LOG_DIR}/__DOMAIN__.error.log
    CustomLog ${APACHE_LOG_DIR}/__DOMAIN__.access.log combined
</VirtualHost>

__HTTPS_BLOCK__
